<Page
    x:Class="ChatRoomReset.Pages.InitPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Width="420">
            <TextBlock Text="Chat Room 重置版" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="第一步：配置服务器地址" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>

            <TextBox x:Name="ServerBox" Header="服务器地址" PlaceholderText="http://localhost:3000" Text="{x:Bind ServerText, Mode=TwoWay}"/>
            <Button x:Name="ConnectBtn" Content="连接服务器" Style="{StaticResource AccentButtonStyle}" Click="ConnectBtn_Click" HorizontalAlignment="Stretch" Height="40"/>

            <TextBlock x:Name="StatusText" Text="" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap"/>

            <TextBlock Text="提示：需要先启动后端 server，再在此填写其地址（默认 http://localhost:3000）" 
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Page>
