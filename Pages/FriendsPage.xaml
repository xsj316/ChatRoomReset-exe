<Page
    x:Class="ChatRoomReset.Pages.FriendsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部操作区 -->
        <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="私聊" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button x:Name="RequestsBtn" Content="好友申请" Click="RequestsBtn_Click" VerticalAlignment="Center">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="320">
                                <TextBlock Text="好友申请" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ListView x:Name="RequestsList" MaxHeight="320" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Username}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="请求添加你为好友" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="同意" Tag="{Binding}" Click="AcceptRequest_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="RequestsEmptyText" Text="暂无新的好友申请" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="搜索用户添加好友（输入用户名）" KeyDown="SearchBox_KeyDown"/>
                <Button x:Name="SearchBtn" Grid.Column="1" Content="搜索" Click="SearchBtn_Click"/>
            </Grid>
        </StackPanel>

        <!-- 好友列表 -->
        <Grid Grid.Row="1">
            <ListView x:Name="FriendList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="FriendList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Username}" FontSize="16" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE8BD;" FontSize="16" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="还没有好友" FontSize="18" HorizontalAlignment="Center"/>
                <TextBlock Text="在上方搜索用户名，添加好友开始私聊" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
