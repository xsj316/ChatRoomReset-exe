<Page
    x:Class="ChatRoomReset.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="24,16,24,24" MaxWidth="720" HorizontalAlignment="Left">

            <!-- 账号信息 -->
            <Border CornerRadius="12" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="账号" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AccountText" Text="未登录" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button x:Name="LogoutBtn" Content="退出登录" Click="LogoutBtn_Click"/>
                </StackPanel>
            </Border>

            <!-- 服务器设置 -->
            <Border CornerRadius="12" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="服务器" FontSize="18" FontWeight="SemiBold"/>
                    <TextBox x:Name="ServerBox" Header="服务器地址" PlaceholderText="http://localhost:3000"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="SaveServerBtn" Content="保存并重连" Style="{StaticResource AccentButtonStyle}" Click="SaveServerBtn_Click"/>
                        <TextBlock x:Name="ServerStatusText" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 外观 -->
            <Border CornerRadius="12" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="外观" FontSize="18" FontWeight="SemiBold"/>
                    <RadioButtons x:Name="ThemePicker" SelectedIndex="0">
                        <x:String>浅色</x:String>
                        <x:String>深色</x:String>
                    </RadioButtons>
                    <Button x:Name="SaveThemeBtn" Content="保存主题" Click="SaveThemeBtn_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- 兑换码 -->
            <Border CornerRadius="12" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="兑换积分" FontSize="18" FontWeight="SemiBold"/>
                    <TextBox x:Name="RedeemBox" Header="兑换码" PlaceholderText="输入对话码兑换积分"/>
                    <Button x:Name="RedeemBtn" Content="兑换" Click="RedeemBtn_Click" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="RedeemStatusText" Foreground="{ThemeResource SystemFillColorSuccessBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
