<Page
    x:Class="ChatRoomReset.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Width="420">
            <TextBlock Text="登录" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="ServerLabel" Text="" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

            <TextBox x:Name="UsernameBox" Header="用户名或邮箱" PlaceholderText="请输入用户名或邮箱"/>
            <PasswordBox x:Name="PasswordBox" Header="密码" PlaceholderText="请输入密码" KeyDown="PasswordBox_KeyDown"/>
            <Button x:Name="LoginBtn" Content="登录" Style="{StaticResource AccentButtonStyle}" Click="LoginBtn_Click" HorizontalAlignment="Stretch" Height="40"/>
            <TextBlock x:Name="StatusText" Text="" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24">
                <HyperlinkButton Content="忘记密码？" Click="Forgot_Click"/>
                <HyperlinkButton Content="没有账号？去注册" Click="GoRegister_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
