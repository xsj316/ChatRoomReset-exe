<Page
    x:Class="ChatRoomReset.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <!-- 第一步：填写注册信息（用户名+密码+邮箱） -->
        <StackPanel x:Name="FormPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Width="420">
            <TextBlock Text="注册新账号" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>

            <TextBox x:Name="UsernameBox" Header="用户名" PlaceholderText="2-20位字母、数字或下划线"/>
            <TextBox x:Name="EmailBox" Header="邮箱" PlaceholderText="用于接收验证码，一邮箱一账号"/>
            <PasswordBox x:Name="PasswordBox" Header="密码" PlaceholderText="6-32位"/>
            <PasswordBox x:Name="ConfirmBox" Header="确认密码" PlaceholderText="再次输入密码" KeyDown="ConfirmBox_KeyDown"/>
            <Button x:Name="RegisterBtn" Content="注册" Style="{StaticResource AccentButtonStyle}" Click="RegisterBtn_Click" HorizontalAlignment="Stretch" Height="40"/>
            <TextBlock x:Name="StatusText" Text="" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap"/>

            <HyperlinkButton Content="已有账号？返回登录" Click="Back_Click" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 第二步：邮箱验证码确认（验证通过后才能登录） -->
        <StackPanel x:Name="VerifyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Width="420" Visibility="Collapsed">
            <TextBlock Text="验证邮箱" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="VerifyHintText" Text="" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
            <TextBox x:Name="CodeBox" Header="邮箱验证码" PlaceholderText="请输入收到的 6 位验证码" KeyDown="CodeBox_KeyDown"/>
            <Button x:Name="VerifyBtn" Content="确认验证" Style="{StaticResource AccentButtonStyle}" Click="VerifyBtn_Click" HorizontalAlignment="Stretch" Height="40"/>
            <Button x:Name="ResendBtn" Content="重新发送验证码" Click="ResendBtn_Click" HorizontalAlignment="Stretch" Height="36"/>
            <TextBlock x:Name="VerifyStatusText" Text="" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap"/>
            <HyperlinkButton Content="返回修改注册信息" Click="BackToForm_Click" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
